{
  "name": "shl-alubin-concept",
  "version": "0.0.0",
  "private": true,
  "description": "Unsolicited concept site for SHL-Alubin by Kikkey. Not the official SHL-Alubin website.",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/check-tokens.mjs && next build",
    "start": "npx serve@14 out -l 3000",
    "typecheck": "tsc --noEmit",
    "check:tokens": "node scripts/check-tokens.mjs",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "geist": "1.9.2",
    "next": "15.5.29",
    "react": "19.2.9",
    "react-dom": "19.2.9"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@fontsource/ibm-plex-sans-hebrew": "5.3.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.20.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "postcss": "8.5.32",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "wrangler": "4.152.0"
  },
  "engines": {
    "node": ">=20.9"
  }
}
